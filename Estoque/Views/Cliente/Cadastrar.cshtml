@model Estoque.Models.Cliente.ClienteModel

<div class="d-flex flex-column min-vh-100">

    <div class="container mt-5 flex-grow-1">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card shadow p-4">
                    <h2 class="text-center mb-4">Cadastrar</h2>

                    <form asp-action="Cadastrar" method="post">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CPF" class="form-label"></label>
                            <input asp-for="CPF" class="form-control" id="cpf"/>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" id="nome"/>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" id="email"/>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Senha" class="form-label"></label>
                            <input asp-for="Senha" type="password" class="form-control" id="senha" />
                        </div>

                        <button type="submit" class="btn btn-success w-100" id="cadastrar">
                            Cadastrar
                        </button>
                            
                        <div class="text-center mt-3">
                            Já possui conta?
                            <a asp-controller="Cliente" asp-action="Logar">
                                Login
                            </a>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

</div>

<script>

    const role = document.getElementById('role');
    const roles = document.getElementById('_roles');
        
    roles.addEventListener('change', () => {
        role.value = roles.value;
    });

</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}