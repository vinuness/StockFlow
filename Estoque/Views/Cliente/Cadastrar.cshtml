@model Estoque.Models.Cliente.ClienteModel

<div class="d-flex flex-column min-vh-100">

    <div class="container mt-5 flex-grow-1">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card shadow p-4">
                    <h2 class="text-center mb-4">Cadastrar</h2>

                    <form asp-action="Cadastrar" method="post">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CPF" class="form-label"></label>
                            <input asp-for="CPF" class="form-control" id="cpf"/>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" id="nome"/>
                        </div>

                        <h5 class="mt-4 mb-3">Endereço</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereco.Cep" class="form-label"></label>
                                <input asp-for="Endereco.Cep" class="form-control" id="cep"/>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereco.Estado" class="form-label"></label>
                                <input asp-for="Endereco.Estado" class="form-control" id="estado"/>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereco.Cidade" class="form-label"></label>
                                <input asp-for="Endereco.Cidade" class="form-control" id="cidade"/>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereco.Bairro" class="form-label"></label>
                                <input asp-for="Endereco.Bairro" class="form-control" id="bairro"/>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="Endereco.Rua" class="form-label"></label>
                                <input asp-for="Endereco.Rua" class="form-control" id="rua"/>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" id="email"/>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Senha" class="form-label"></label>
                            <input asp-for="Senha" type="password" class="form-control" id="senha"/>
                        </div>

                        <button type="submit" class="btn btn-success w-100" id="cadastrar">
                            Cadastrar
                        </button>
                            
                        <div class="text-center mt-3">
                            Já possui conta?
                            <a asp-controller="Cliente" asp-action="Logar">
                                Login
                            </a>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cadastro.js"></script>
}