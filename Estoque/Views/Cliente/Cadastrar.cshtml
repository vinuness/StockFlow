@model Estoque.Models.Cliente.ClienteModel

@{
    ViewData["Title"] = "Cadastro";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- 🔥 Wrapper para empurrar footer -->
<div class="d-flex flex-column min-vh-100">

    <div class="container mt-5 flex-grow-1">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card shadow p-4">
                    <h2 class="text-center mb-4">Cadastrar Cliente</h2>

                    <form asp-action="Cadastrar" method="post">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CPF" class="form-label"></label>
                            <input asp-for="CPF" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" />
                        </div>

                        <h5 class="mt-4 mb-3">Endereço</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereço.Cep" class="form-label"></label>
                                <input asp-for="Endereço.Cep" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereço.Estado" class="form-label"></label>
                                <input asp-for="Endereço.Estado" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereço.Cidade" class="form-label"></label>
                                <input asp-for="Endereço.Cidade" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereço.Bairro" class="form-label"></label>
                                <input asp-for="Endereço.Bairro" class="form-control" />
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="Endereço.Rua" class="form-label"></label>
                                <input asp-for="Endereço.Rua" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Senha" class="form-label"></label>
                            <input asp-for="Senha" type="password" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            Cadastrar
                        </button>

                        <div class="text-center mt-3">
                            Já possui conta?
                            <a asp-controller="Cliente" asp-action="Logar">
                                Login
                            </a>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}