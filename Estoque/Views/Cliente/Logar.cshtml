@model Estoque.Models.Cliente.LoginModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow p-4">
                <h2 class="text-center mb-4">Login</h2>

                <form asp-action="Logar" method="post">

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" id="email"/>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label"></label>
                        <input asp-for="Senha" type="password" class="form-control" id="senha"/>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Entrar
                    </button>

                    <div class="text-center mt-3">
                        Não possui conta?
                        <a asp-controller="Cliente" asp-action="Cadastrar">
                            Cadastre-se
                        </a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>  
@if (TempData["Error"] != null)
{
    <script type="text/javascript">
        alert('@TempData["Error"].ToString()');
    </script>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}