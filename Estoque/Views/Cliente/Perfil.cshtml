@model Estoque.Models.Cliente.ClienteModel;

@{
    var cliente = Model;
}

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">StockFlow</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Estoque" asp-action="Index">Estoque</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Categoria" asp-action="Index">Categorias</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Fornecedor" asp-action="Index">Fornecedores</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Pedido" asp-action="Index">Pedidos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Estoque" asp-action="Carrinho">Carrinho</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Cliente" asp-action="Perfil">Perfil</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h3 class="mb-0">Meu Perfil</h3>
                </div>

                <div class="card-body p-4">

                    <h5 class="mb-3 text-secondary">Informações pessoais</h5>

                    <div class="mb-2">
                        <span class="d-none" id="id"></span>
                    </div>

                    <div class="mb-2">
                        <strong>Nome:</strong> @cliente.Nome <span id="nome"></span>
                    </div>

                    <div class="mb-4">
                        <strong>Email:</strong> @cliente.Email <span id="email"></span>
                    </div>

                    <hr />

                    <h5 class="mb-3 text-secondary">Endereço</h5>

                    <div class="row">

                        <div class="col-md-6 mb-2">
                            <strong>CEP:</strong> @cliente.Endereco?.Cep <span id="cep"></span>
                        </div>

                        <div class="col-md-6 mb-2">
                            <strong>Estado:</strong> @cliente.Endereco?.Estado <span id="estado"></span>
                        </div>

                        <div class="col-md-12 mb-2">
                            <strong>Rua:</strong> @cliente.Endereco?.Rua <span id="rua"></span>
                        </div>

                        <div class="col-md-6 mb-2">
                            <strong>Bairro:</strong> @cliente.Endereco?.Bairro <span id="bairro"></span>
                        </div>

                        <div class="col-md-6 mb-2">
                            <strong>Cidade:</strong> @cliente.Endereco?.Cidade <span id="cidade"></span>
                        </div>

                    </div>

                </div>

            </div>
            <form asp-controller="Cliente" asp-action="Logout" method="post">
                <div class="col-md-6 mb-2">
                    <button style="margin: 2%" class="btn btn-danger" id="sair"> Sair </button>
                </div>
            </form>
        </div>

    </div>

</div>
