@model Estoque.Models.Cliente.ClienteModel;

@{
    var cliente = Model;
}

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">StockFlow</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Estoque" asp-action="Index">Produtos</a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Categoria" asp-action="Index">Categorias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Fornecedor" asp-action="Index">Fornecedores</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Pedido" asp-action="Index">Pedidos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Estoque" asp-action="Carrinho">Carrinho</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Cliente" asp-action="Perfil">Perfil</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h3 class="mb-0">Meu Perfil</h3>
                </div>

                <div class="card-body p-4">

                    <h5 class="mb-3 text-secondary">Informações pessoais</h5>

                    <div class="mb-2">
                        <span class="d-none" id="id"></span>
                    </div>

                    <div class="mb-2">
                        <strong>Nome:</strong> @cliente.Nome <span id="nome"></span>
                    </div>

                    <div class="mb-4">
                        <strong>Email:</strong> @cliente.Email <span id="email"></span>
                    </div>

                    <hr />
                    <h5 class="mb-3 text-secondary">Endereço de Entrega</h5>
                    @foreach(var endereco in cliente.Enderecos)
                    {
                        if(endereco.Principal == true)
                        {
                            <div class="card" style="width: 18rem;">
                                <div class="card-body">
                                    <div class="mb-2">
                                        <strong>Rua:</strong> @endereco.Rua
                                    </div>
                                    <div class="mb-2">
                                        <strong>Número:</strong> @endereco.Numero
                                    </div>
                                    <div class="mb-2">
                                        <strong>Cidade:</strong> @endereco.Cidade
                                    </div>
                                    <div class="mb-2">
                                        <strong>Estado:</strong> @endereco.Estado
                                    </div>
                                    <div class="mb-4">
                                        <strong>CEP:</strong> @endereco.Cep
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <hr />

                    @if (cliente.Enderecos != null && cliente.Enderecos.Any())
                    {
                        <h5 class="mb-3 text-secondary">Endereços</h5>

                        <div class="row row-cols-1 row-cols-md-3 g-4">
                        @foreach (var endereco in cliente.Enderecos)
                        {

                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card h-100 shadow-sm border-0 rounded-4">

                                        <div class="card-header bg-primary text-white">
                                            <h5 class="mb-0">Endereço</h5>
                                        </div>

                                        <div class="card-body">

                                            <p class="mb-2">
                                                <strong>Rua:</strong> @endereco.Rua
                                            </p>

                                            <p class="mb-2">
                                                <strong>Número:</strong> @endereco.Numero
                                            </p>

                                            <p class="mb-2">
                                                <strong>Bairro:</strong> @endereco.Bairro
                                            </p>

                                            <p class="mb-2">
                                                <strong>Cidade:</strong> @endereco.Cidade
                                            </p>

                                            <p class="mb-2">
                                                <strong>Estado:</strong> @endereco.Estado
                                            </p>

                                            <p class="mb-0">
                                                <strong>CEP:</strong> @endereco.Cep
                                            </p>

                                        </div>

                                        <div class="card-footer bg-white border-0">

                                            <div class="d-grid gap-2">

                                                <form asp-action="SetPrincipalAdress" method="post">
                                                    <input type="hidden" name="id" value="@endereco.Id" />

                                                    <button type="submit" class="btn btn-success w-100">
                                                        Definir como Principal
                                                    </button>
                                                </form>

                                                <a asp-action="UpdateAdress"
                                                   asp-route-id="@endereco.Id"
                                                   class="btn btn-primary w-100">
                                                    Editar
                                                </a>

                                                <form asp-action="RemoveAdress" method="post">
                                                    <input type="hidden" name="id" value="@endereco.Id" />

                                                    <button type="submit" class="btn btn-outline-danger w-100">
                                                        Remover
                                                    </button>
                                                </form>

                                            </div>

                                        </div>

                                    </div>
                                </div>

                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Nenhum endereço cadastrado.</p>
                    }

                </div>

            </div>
            <form asp-controller="Cliente" asp-action="Logout" method="post">
                <div class="col-md-6 mb-2">
                    <button style="margin: 2%" class="btn btn-danger" id="sair"> Sair </button>
                </div>
            </form>
            <div class="col-md-6 mb-2">
                    <a class="btn btn-dark" asp-controller="Cliente" asp-action="AddEndereco">Adicionar Endereço</a>
            </div>
        </div>

    </div>

</div>
