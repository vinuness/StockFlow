<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h3 class="mb-0">Meu Perfil</h3>
                </div>

                <div class="card-body p-4">

                    <h5 class="mb-3 text-secondary">Informações pessoais</h5>

                    <div class="mb-2">
                        <span class="d-none" id="id"></span>
                    </div>

                    <div class="mb-2">
                        <strong>Nome:</strong> <span id="nome"></span>
                    </div>

                    <div class="mb-4">
                        <strong>Email:</strong> <span id="email"></span>
                    </div>

                    <hr />

                    <h5 class="mb-3 text-secondary">Endereço</h5>

                    <div class="row">

                        <div class="col-md-6 mb-2">
                            <strong>CEP:</strong> <span id="cep"></span>
                        </div>

                        <div class="col-md-6 mb-2">
                            <strong>Estado:</strong> <span id="estado"></span>
                        </div>

                        <div class="col-md-12 mb-2">
                            <strong>Rua:</strong> <span id="rua"></span>
                        </div>

                        <div class="col-md-6 mb-2">
                            <strong>Bairro:</strong> <span id="bairro"></span>
                        </div>

                        <div class="col-md-6 mb-2">
                            <strong>Cidade:</strong> <span id="cidade"></span>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

<script src="~/js/perfil.js"></script>