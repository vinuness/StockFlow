@model List<Estoque.Models.FornecedorModel>

@{
    var fornecedores = Model;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>
        <h1 class="fw-bold mb-1">Fornecedores</h1>
        <p class="text-muted mb-0">Gerencie os fornecedores dos produtos</p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>
        Adicionar Fornecedor
    </a>

</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">

        <div class="input-group">
            <span class="input-group-text bg-white">
                <i class="bi bi-search"></i>
            </span>

            <input class="form-control"
                   type="search"
                   placeholder="Pesquisar fornecedor..."
                   aria-label="Pesquisar fornecedor"
                   id="search" />
        </div>

    </div>
</div>

<div class="card border-0 shadow-sm">

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th scope="col" class="ps-4">
                        ID
                    </th>

                    <th scope="col">
                        Nome
                    </th>

                    <th scope="col">
                        CNPJ
                    </th>

                    <th scope="col">
                        Telefone
                    </th>

                    <th scope="col">
                        Email
                    </th>

                    <th scope="col" class="text-end pe-4">
                        Ações
                    </th>
                </tr>
            </thead>

            <tbody>

                @foreach (var fornecedor in fornecedores)
                {
                    <tr class="fornecedor-row">

                        <td class="ps-4 text-muted">
                            #@fornecedor.Id
                        </td>

                        <td class="fornecedor-name fw-semibold">
                            @fornecedor.Nome
                        </td>

                        <td>
                            @fornecedor.Cnpj
                        </td>

                        <td>
                            @fornecedor.Telefone
                        </td>

                        <td>
                            @fornecedor.Email
                        </td>

                        <td class="text-end pe-4">

                            <a asp-controller="Fornecedor"
                               asp-action="Edit"
                               asp-route-id="@fornecedor.Id"
                               class="btn btn-primary btn-sm">
                                <i class="bi bi-pencil me-1"></i>
                                Editar
                            </a>

                            <a asp-controller="Fornecedor"
                               asp-action="Delete"
                               asp-route-id="@fornecedor.Id"
                               class="btn btn-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>
                                Excluir
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script>
    const searchInput = document.getElementById("search");
    const rows = document.querySelectorAll(".fornecedor-row");

    searchInput.addEventListener("input", function (event) {

        const value = formatString(event.target.value);

        rows.forEach(row => {

            const content = formatString(row.textContent);

            row.style.display = content.includes(value) ? "" : "none";

        });

    });

    function formatString(value) {
        return value
            .toLowerCase()
            .trim();
    }
</script>