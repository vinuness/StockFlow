@model List<Estoque.Models.PedidoModel>

<h1>Pedidos</h1>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        Nenhum pedido encontrado.
    </div>
}
else
{
    @foreach (var pedido in Model)
    {
        <div class="card mb-4">
            <div class="card-header">
                <strong>Pedido #@pedido.Id</strong>
                <br />
                Data: @pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")
                <br />
                Status: @pedido.Status
            </div>

            <div class="card-body">

                @if (pedido.ItensPedido != null && pedido.ItensPedido.Any())
                {
                    <table class="table table-striped table-sm">

                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Descrição</th>
                                <th>Categoria</th>
                                <th>Fornecedor</th>
                                <th>Preço Unitário</th>
                                <th>Quantidade</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in pedido.ItensPedido)
                            {
                                <tr>
                                    <td>@item.Produto?.Nome</td>

                                    <td>@item.Produto?.Descricao</td>

                                    <td>
                                        @item.Produto?.Categoria?.Nome
                                    </td>

                                    <td>
                                        @item.Produto?.Fornecedor?.Nome
                                    </td>

                                    <td>
                                        R$ @item.PrecoUnitario.ToString("F2")
                                    </td>

                                    <td>
                                        @item.Quantidade
                                    </td>

                                    <td>
                                        R$ @((item.PrecoUnitario * item.Quantidade).ToString("F2"))
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <p class="text-muted">
                        Este pedido não possui itens.
                    </p>
                }

            </div>
        </div>
    }
}
