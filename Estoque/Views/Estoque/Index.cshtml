@model List<Estoque.Models.EstoqueModel>

@{
    var imagem = "https://localhost:7238/api/Produto/imagem/";
}

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">StockFlow</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Estoque" asp-action="Index">Produtos</a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Categoria" asp-action="Index">Categorias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Fornecedor" asp-action="Index">Fornecedores</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Pedido" asp-action="Index">Pedidos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Estoque" asp-action="Carrinho">Carrinho</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Cliente" asp-action="Perfil">Perfil</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container mt-4">

    <h1 class="text-center mb-4">Produtos</h1>

    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
    {
        <a asp-action="Create" class="btn btn-success">Adicionar Produto</a>
    }
    
    <hr />
    <div class="row">
        @foreach (var produto in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 text-center shadow-sm">
                    @if (produto.Imagens != null && produto.Imagens.Any())
                    {
                        <div id="carousel-@produto.Id" class="carousel slide" data-bs-ride="carousel">

                            <div class="carousel-inner">

                                @for (int i = 0; i < produto.Imagens.Count; i++)
                                {
                                    var img = produto.Imagens[i];

                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@($"{imagem}{img.Id}")"
                                             class="d-block w-100"
                                             style="height:220px; object-fit:contain;" />
                                    </div>
                                }

                            </div>

                            @if (produto.Imagens.Count > 1)
                            {
                                <button class="carousel-control-prev"
                                        type="button"
                                        data-bs-target="#carousel-@produto.Id"
                                        data-bs-slide="prev">

                                    <span class="carousel-control-prev-icon"></span>

                                </button>

                                <button class="carousel-control-next"
                                        type="button"
                                        data-bs-target="#carousel-@produto.Id"
                                        data-bs-slide="next">

                                    <span class="carousel-control-next-icon"></span>

                                </button>
                            }

                        </div>
                    }
                    else
                    {
                        <img src="/images/sem-imagem.png"
                             class="card-img-top"
                             style="height:220px; object-fit:contain;" />
                    }

                    <div class="card-body">

                        <h5 class="text-success">
                            R$ @produto.Preco.ToString("F2")
                        </h5>

                        <div class="d-flex justify-content-center">
                            <h6 class="badge bg-secondary p-6 m-3">
                                @produto.Cor
                            </h6>
                            <h6 class="badge bg-secondary p-6 m-3">
                                @produto.Tamanho
                            </h6>
                        </div>

                        <h4>@produto.Nome</h4>

                        <p>@produto.Descricao</p>

                        <a asp-action="AddCarrinho"
                           asp-route-id="@produto.Id"
                           class="btn btn-primary">
                            Adicionar ao Carrinho
                        </a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                        {
                            <a asp-action="Delete"
                            asp-route-id="@produto.Id"
                            class="btn btn-danger">
                                Excluir
                            </a>
                            <hr />
                            <a asp-action="Edit"
                            asp-route-id="@produto.Id"
                            class="btn btn-warning">
                                Editar
                            </a>
                        }
                    </div>

                    <div class="card-footer text-muted">
                        Estoque: @produto.Quantidade
                    </div>

                </div>
            </div>
        }
    </div>

</div>