@model List<Estoque.Models.EstoqueModel>

@{
    var imagem = "https://localhost:7238/api/Produto/imagem/";
}

<div class="container mt-4">
    <div class="d-flex p-4 p-md-5 mb-4 rounded text-bg-dark shadow-sm">
        <div class="col-md-8 px-0">
            <h1 class="display-5 fw-bold">Bem-vindo ao StockFlow</h1>
            <p class="lead my-3">
                Encontre os produtos que você procura, explore nossas opções e aproveite uma experiência de compra simples, rápida e segura.
            </p>
        </div>
    </div>


    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">

                <div class="input-group flex-grow-1">

                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>

                    <input class="form-control"
                           type="search"
                           placeholder="Pesquisar produto..."
                           aria-label="Pesquisar produto"
                           id="search" />

                </div>

                @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                {
                    <a asp-action="Create"
                       class="btn btn-success flex-shrink-0">

                        <i class="bi bi-plus-lg me-1"></i>
                        Adicionar Produto

                    </a>
                }

            </div>

        </div>

    </div>

    <div class="row g-4" id="products">

        @foreach (var produto in Model)
        {
            <div class="col-md-3 product-item">

                <div class="card product-card h-100 text-center shadow-sm">

                    @if (produto.Imagens != null && produto.Imagens.Any())
                    {
                        <div id="carousel-@produto.Id"
                             class="carousel slide"
                             data-bs-ride="carousel">

                            <div class="carousel-inner">

                                @for (int i = 0; i < produto.Imagens.Count; i++)
                                {
                                    var img = produto.Imagens[i];

                                    <div class="carousel-item @(i == 0 ? "active" : "")">

                                        <img src="@($"{imagem}{img.Id}")"
                                             class="d-block w-100 product-img"
                                             alt="@produto.Nome" />

                                    </div>
                                }

                            </div>

                            @if (produto.Imagens.Count > 1)
                            {
                                <button class="carousel-control-prev"
                                        type="button"
                                        data-bs-target="#carousel-@produto.Id"
                                        data-bs-slide="prev">

                                    <span class="carousel-control-prev-icon"></span>

                                </button>

                                <button class="carousel-control-next"
                                        type="button"
                                        data-bs-target="#carousel-@produto.Id"
                                        data-bs-slide="next">

                                    <span class="carousel-control-next-icon"></span>

                                </button>
                            }

                        </div>
                    }
                    else
                    {
                        <img src="/images/sem-imagem.png"
                             class="card-img-top product-img"
                             alt="Produto sem imagem" />
                    }

                    <div class="card-body d-flex flex-column">

                        <h5 class="text-success">
                            R$ @produto.Preco.ToString("F2")
                        </h5>

                        <div class="d-flex justify-content-center gap-2 mb-3">

                            <h6 class="badge bg-secondary p-2 m-0">
                                @produto.Cor
                            </h6>

                            <h6 class="badge bg-secondary p-2 m-0">
                                @produto.Tamanho
                            </h6>

                        </div>

                        <h4 class="product-name">
                            @produto.Nome
                        </h4>

                        <p class="product-description">
                            @produto.Descricao
                        </p>

                        <div class="mt-auto">

                            @if(User.Identity.IsAuthenticated && User.Identity != null)
                            {
                                <a asp-action="AddCarrinho"
                                   asp-route-id="@produto.Id"
                                   class="btn btn-primary w-100 mb-2">
                                    Adicionar ao Carrinho
                                </a>
                            }

                            <a asp-action="Details" asp-route-id="@produto.Id" class="btn btn-outline-secondary w-100 mb-2">
                                <i class="bi bi-eye me-1"></i>
                                Ver detalhes
                            </a>

                            @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                            {
                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@produto.Id"
                                       class="btn btn-warning flex-fill">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@produto.Id"
                                       class="btn btn-danger flex-fill">
                                        Excluir
                                    </a>

                                </div>
                            }

                        </div>

                    </div>

                    <div class="card-footer text-muted">
                        Estoque: @produto.Quantidade
                    </div>

                </div>

            </div>
        }

    </div>

</div>

<script>
    const searchInput = document.getElementById("search");
    const products = document.querySelectorAll(".product-item");

    searchInput.addEventListener("input", function (event) {

        const value = formatString(event.target.value);

        products.forEach(product => {

            const content = formatString(product.textContent);

            product.style.display =
                content.includes(value) ? "" : "none";

        });
    });

    function formatString(value) {
        return value
            .toLowerCase()
            .trim();
    }
</script>