@model Estoque.Models.ProdutoCreateViewModel

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Editar Produto</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label">Nome</label>
                            <input asp-for="Nome" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Quantidade</label>
                            <input asp-for="Quantidade" class="form-control" type="number" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cor</label>
                            <input asp-for="Cor" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tamanho</label>
                            <input asp-for="Tamanho" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descrição</label>
                            <input asp-for="Descricao" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Preço</label>
                            <input asp-for="Preco" class="form-control" type="number" step="0.01" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ID da Categoria</label>
                            <input asp-for="CategoriaId" class="form-control" type="number" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ID do Fornecedor</label>
                            <input asp-for="FornecedorId" class="form-control" type="number" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Adicionar Imagem</label>
                            <input asp-for="Imagem" class="form-control" type="file" accept="image/*" multiple />
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success">
                                Salvar
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>