@model Estoque.Models.EstoqueModel

@{
    var produto = Model;
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Criar Produto</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Create" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label">Nome</label>
                            <input asp-for="Nome" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Quantidade</label>
                            <input asp-for="Quantidade" class="form-control" type="number" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descrição</label>
                            <input asp-for="Descricao" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Preço de Custo</label>
                            <input asp-for="Preco" class="form-control" type="number" step="0.01" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Id da Categoria</label>
                            <input asp-for="CategoriaId" class="form-control" type="number" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Id do Fornecedor</label>
                            <input asp-for="FornecedorId" class="form-control" type="number" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Adicionar Imagem</label>
                            <input asp-for="ImagemUrl" class="form-control" />
                            <label class="form-label mt-2">Ou Adicionar arquivo</label>
                            <input asp-for="ImagemUrl" class="form-control" type="file" accept=".jpg,.jpeg,.png" />
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success">
                                Salvar
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>