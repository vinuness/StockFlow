@model Estoque.Models.ProdutoCreateViewModel

@{
    var produto = Model;
}

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">StockFlow</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Estoque" asp-action="Index">Estoque</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Categoria" asp-action="Index">Categorias</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Fornecedor" asp-action="Index">Fornecedores</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Pedido" asp-action="Index">Pedidos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Estoque" asp-action="Carrinho">Carrinho</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Cliente" asp-action="Perfil">Perfil</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Criar Produto</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantidade" class="form-label"></label>
                            <input asp-for="Quantidade" class="form-control" type="number" />
                            <span asp-validation-for="Quantidade" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cor" class="form-label"></label>
                            <input asp-for="Cor" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tamanho" class="form-label"></label>
                            <input asp-for="Tamanho" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descricao" class="form-label"></label>
                            <textarea asp-for="Descricao" class="form-control"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Preco" class="form-label"></label>
                            <input asp-for="Preco" class="form-control" type="number" step="0.01" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoriaId" class="form-label">Categoria</label>
                            <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                                <option value="">Selecione uma categoria</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FornecedorId" class="form-label">Fornecedor</label>
                            <select asp-for="FornecedorId" asp-items="ViewBag.Fornecedores" class="form-select">
                                <option value="">Selecione um fornecedor</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Imagem" class="form-label"></label>
                            <input asp-for="Imagem" class="form-control" type="file" accept="image/*" multiple/>
                            <span asp-validation-for="Imagem" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success">
                                Salvar
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}