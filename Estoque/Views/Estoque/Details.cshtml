@model Estoque.Models.EstoqueModel

@{
    var imagem = "https://localhost:7238/api/Produto/imagem/";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-primary">
            Voltar
        </a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">

        <div class="row g-0">

            <div class="col-lg-7">

                @if (Model.Imagens != null && Model.Imagens.Any())
                {
                    <div id="productCarousel"
                         class="carousel slide h-100"
                         data-bs-ride="carousel">

                        <div class="carousel-inner h-100">

                            @for (int i = 0; i < Model.Imagens.Count; i++)
                            {
                                var img = Model.Imagens[i];

                                <div class="carousel-item @(i == 0 ? "active" : "") h-100">

                                    <img src="@($"{imagem}{img.Id}")"
                                         class="d-block w-100 details-product-img"
                                         alt="@Model.Nome" />

                                </div>
                            }

                        </div>

                        @if (Model.Imagens.Count > 1)
                        {
                            <button class="carousel-control-prev"
                                    type="button"
                                    data-bs-target="#productCarousel"
                                    data-bs-slide="prev">

                                <span class="carousel-control-prev-icon"></span>

                            </button>

                            <button class="carousel-control-next"
                                    type="button"
                                    data-bs-target="#productCarousel"
                                    data-bs-slide="next">

                                <span class="carousel-control-next-icon"></span>

                            </button>
                        }

                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center h-100 bg-light">

                        <img src="/images/sem-imagem.png"
                             class="img-fluid details-no-image"
                             alt="Produto sem imagem" />

                    </div>
                }

            </div>

            <div class="col-lg-5">

                <div class="p-4 p-lg-5 d-flex flex-column h-100">

                    <div class="mb-3">

                        <span class="badge bg-success mb-3">
                            Produto
                        </span>

                        <h1 class="fw-bold mb-2">
                            @Model.Nome
                        </h1>

                        <p class="text-muted mb-0">
                            Código do produto: #@Model.SKU
                        </p>

                    </div>

                    <hr />

                    <div class="mb-4">

                        <span class="text-muted d-block mb-1">
                            Preço
                        </span>

                        <h2 class="fw-bold text-success mb-0">
                            R$ @Model.Preco.ToString("F2")
                        </h2>

                    </div>

                    <div class="mb-4">

                        <h5 class="fw-bold mb-3">
                            Informações
                        </h5>

                        <div class="d-flex gap-2 flex-wrap">

                            <span class="badge bg-secondary p-2">
                                <i class="bi bi-palette me-1"></i>
                                @Model.Cor
                            </span>

                            <span class="badge bg-secondary p-2">
                                <i class="bi bi-rulers me-1"></i>
                                @Model.Tamanho
                            </span>

                        </div>

                    </div>

                    <div class="mb-4">

                        <h5 class="fw-bold mb-2">
                            Descrição
                        </h5>

                        <p class="text-muted">
                            @Model.Descricao
                        </p>

                    </div>

                    <div class="mb-4">

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <span class="fw-semibold">
                                Disponibilidade
                            </span>

                            <span class="fw-bold @(Model.Quantidade > 0 ? "text-success" : "text-danger")">

                                @if (Model.Quantidade > 0)
                                {
                                    @:Em estoque
                                }
                                else
                                {
                                    @:Fora de estoque
                                }

                            </span>

                        </div>

                        <div class="progress" style="height: 8px;">

                            <div class="progress-bar @(Model.Quantidade > 0 ? "bg-success" : "bg-danger")"
                                 role="progressbar"
                                 style="width: @(Model.Quantidade > 0 ? "100%" : "0%")">
                            </div>

                        </div>

                        <small class="text-muted">
                            @Model.Quantidade unidade(s) disponível(is)
                        </small>

                    </div>

                    <div class="mt-auto">

                        @if (Model.Quantidade > 0)
                        {
                            @if (User.Identity.IsAuthenticated && User.Identity != null)
                            {
                                <a asp-action="AddCarrinho"
                                asp-route-id="@Model.Id"
                                class="btn btn-primary btn-lg w-100 mb-2">

                                    <i class="bi bi-cart-plus me-2"></i>
                                    Adicionar ao Carrinho

                                </a>
                            }
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-lg w-100 mb-2"
                                    disabled>

                                <i class="bi bi-cart-x me-2"></i>
                                Produto indisponível

                            </button>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                        {
                            <div class="d-flex gap-2 mt-2">

                                <a asp-action="Edit"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-warning flex-fill">

                                    <i class="bi bi-pencil me-1"></i>
                                    Editar

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-danger flex-fill">

                                    <i class="bi bi-trash me-1"></i>
                                    Excluir

                                </a>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
