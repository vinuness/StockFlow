@model List<Estoque.Models.EstoqueModel>

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">StockFlow</a>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Estoque" asp-action="Index">Produtos</a>
                    </li>
                    @if (User.HasClaim(c => c.Type == "role" && c.Value == "Admin") ||
                                                         User.HasClaim(c => c.Type == "role" && c.Value == "Operador")
                                                    )
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Categoria" asp-action="Index">Categorias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Fornecedor" asp-action="Index">Fornecedores</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Pedido" asp-action="Index">Pedidos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Estoque" asp-action="Carrinho">Carrinho</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Cliente" asp-action="Perfil">Perfil</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<h1>Carrinho</h1>

<form asp-controller="Pedido"
      asp-action="FazerPedido"
      method="post">

    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>SKU</th>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Preço</th>
                <th>Quantidade</th>
                <th>Categoria</th>
                <th>Fornecedor</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@Model[i].SKU</td>
                    <td>@Model[i].Nome</td>
                    <td>@Model[i].Descricao</td>
                    <td>R$ @Model[i].Preco.ToString("F2")</td>

                    <td>
                        <input type="number"
                               name="[@i].Quantidade"
                               value="1"
                               min="1"
                               max="@Model[i].Quantidade"
                               class="form-control" />
                    </td>

                    <td>@Model[i].Categoria?.Nome</td>
                    <td>@Model[i].Fornecedor?.Nome</td>

                    <td>
                        <a asp-action="RemoverCarrinho"
                           asp-route-id="@Model[i].Id"
                           class="btn btn-danger btn-sm">
                            Remover
                        </a>
                    </td>
                </tr>

                <input type="hidden"
                       name="[@i].ProdutoId"
                       value="@Model[i].Id" />
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between mt-3">
        <a asp-controller="Estoque"
           asp-action="Index"
           class="btn btn-secondary">
            Continuar Comprando
        </a>

        <button type="submit" class="btn btn-success">
            Fazer Pedido
        </button>
    </div>

</form>