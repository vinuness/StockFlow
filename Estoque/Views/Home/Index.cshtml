@model List<Estoque.Models.ProdutoMaisVendidoDTO>
@using System.Text.Json

<div class="container mb-4">

    <div class="p-4 p-md-5 mb-4 rounded text-bg-dark shadow-sm">
        <div class="col-md-8 px-0">
            <h1 class="display-5 fw-bold">Bem-vindo ao StockFlow</h1>
            <p class="lead my-3">
                Gerencie seu estoque, acompanhe vendas e visualize os produtos mais vendidos em tempo real.
            </p>
        </div>
    </div>

    <div class="row mb-4 g-3">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Produtos no ranking</h6>
                    <h3 class="fw-bold">@Model?.Count()</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Produto mais vendido</h6>
                    <h3 class="fw-bold">
                        @Model?.OrderByDescending(x => x.QuantidadeVendida).FirstOrDefault()?.Nome
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Faturamento</h6>

                    <h3 class="fw-bold text-success">
                        @(((double)ViewBag.Faturamento).ToString("C"))
                    </h3>

                    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                    {
                        <button class="btn btn-success mb-3" onclick="baixarFaturamento()">
                            Baixar faturamento
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total de vendas</h6>

                    <h3 class="fw-bold">
                        @Model?.Sum(x => x.QuantidadeVendida)
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h5 class="mb-3">Produtos mais vendidos</h5>

            <canvas id="grafico" height="100"></canvas>
            @if (User.IsInRole("Admin") || User.IsInRole("Operador")){
                <button class="btn btn-primary mb-3" onclick="downloadChart()">
                    Baixar gráfico
                </button>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const ctx = document.getElementById('grafico').getContext('2d');

        const nomes = @Html.Raw(JsonSerializer.Serialize(Model.Select(p => p.Nome)));
        const vendas = @Html.Raw(JsonSerializer.Serialize(Model.Select(p => p.QuantidadeVendida)));
        let chart;

        chart = new Chart(ctx, {
            type: 'bar',
            data: {
            labels: nomes,
            datasets: [{
            label: 'Quantidade Vendida',
            data: vendas,
            backgroundColor: '#4A90E2',
            borderRadius: 6
            }]
        },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                    display: true
                    }
                },
                scales: {
                    y: {
                    beginAtZero: true
                    }
                }
            }
        });

        function downloadChart(){
            const link = document.createElement("a");   

            link.href = chart.toBase64Image();
            link.download = "produtos-mais-vendidos.png";

            link.click();
        }

        function baixarFaturamento() {
        const link = document.createElement("a");

        link.href = "/Home/DownloadFaturamento";
        link.download = "faturamento.txt";

        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        }

    </script>
}